DATABASE_URL=pglite:./data/peopleflow
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Set a strong local demo password BEFORE running db:seed.
SEED_PASSWORD=
# Standard PostgreSQL: postgres://peopleflow:peopleflow@localhost:5432/peopleflow
# Google callback: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Microsoft callback: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Optional grounded AI assistant. Without these, use transparent manual search.
OPENAI_API_KEY=
OPENAI_MODEL=
# LINE Messaging API (one provider application; tenant recipient is set in UI)
LINE_CHANNEL_ACCESS_TOKEN=
# Hosted deployments only: use a separate managed PostgreSQL database.
DEPLOY_MIGRATE=false
SEED_DEMO=false
# Private Vercel Blob token, needed only for hosted lesson uploads.
BLOB_READ_WRITE_TOKEN=
# Local uploads default to data/uploads; never use a public directory.
UPLOAD_DIRECTORY=
