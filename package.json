{
  "name": "peopleflow-hr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "deploy:build": "node --import tsx scripts/prepare-deployment.ts && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "bcryptjs": "^3.0.2",
    "lucide-react": "latest",
    "next": "latest",
    "next-auth": "beta",
    "pg": "^8.16.3",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  }
}
